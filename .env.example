# --- Web (apps/web, Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# public URL used in share links and OG tags (Vercel falls back to the production domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# accounts (Supabase Auth, e-mail + password): Project URL and the publishable/anon key — public by design.
# Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API (apps/api, Render: render.yaml) ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
RATE_LIMIT_PER_MINUTE=120
# Hours a newly bought district is safe from raids (default 48; lower only on a test server)
# LAND_SHIELD_HOURS=48
CREATE_LIMIT_PER_MINUTE=5
# new accounts per client address per hour (POST /v1/auth/signup)
SIGNUP_LIMIT_PER_HOUR=10
# leave empty to keep buds in memory (local dev); set both in production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# the only header trusted for the client IP in rate limits (Render: cf-connecting-ip); empty = X-Real-IP / X-Forwarded-For
CLIENT_IP_HEADER=
# Publishable (anon) key for signing in from the game (public by design; defaults to NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_PUBLISHABLE_KEY=

# Store build of the game (Unity BudsBuild.AndroidRelease, docs/telefon.md): set only in the shell that builds, never
# commit real values. BUDS_KEYSTORE= path to the upload .keystore; BUDS_KEYSTORE_PASS= BUDS_KEY_ALIAS= BUDS_KEY_PASS=
# BUDS_VERSION= e.g. 1.0.0; BUDS_VERSION_CODE= a whole number, higher with every upload
